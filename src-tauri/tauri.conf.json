{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Funqtion Maps",
  "version": "0.1.0",
  "identifier": "nl.funqtion.maps",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Funqtion Maps",
        "width": 1280,
        "height": 800,
        "minWidth": 375,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#040404"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Team Funqtion",
    "shortDescription": "Funqtion Maps — FEEL THE MUSIQ"
  }
}
